# Server
NODE_ENV=development
IP=0.0.0.0
PORT=5000
LOG_LEVEL=debug

# Database
DATABASE_URL=mongodb://127.0.0.1:27017/loggistick

# Auth
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-access-token-secret
JWT_REFRESH_SECRET=replace-with-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=loggistick
JWT_AUDIENCE=loggistick-client
tokenVersion=1

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Seeded super admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password

# Email (SMTP)
EMAIL_FROM=noreply@example.com
EMAIL_USER=noreply@example.com
EMAIL_PASS=replace-with-email-password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

# App
APP_DOWNLOAD_URL=https://loggistick.com/download

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Redis / BullMQ
BULLMQIP=127.0.0.1
BULLMQPORT=6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_NUMBER=+10000000000

# Google Maps
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Social login
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FACEBOOK_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret

# Firebase Admin (FCM). Keep \n escapes in the private key.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
