# ==============================================================================
# LOGISTICS & NEMT SERVER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and provide real values for your environment.
# Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Network IP interface to bind on (0.0.0.0 listens on all interfaces)
IP=0.0.0.0

# HTTP application server port
PORT=5000

# Winston Logger verbosity level: 'error', 'warn', 'info', 'http', 'verbose', 'debug', 'silly'
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Standard MongoDB connection URI with database name.
# For Docker Compose: mongodb://mongodb:27017/loggistickDB
# For Localhost:     mongodb://127.0.0.1:27017/loggistickDB
DATABASE_URL=mongodb://127.0.0.1:27017/loggistickDB

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------
# Salt rounds for Bcrypt password hashing (recommended: 10 - 14)
BCRYPT_SALT_ROUNDS=12

# Secret key used to sign and verify short-lived access tokens
JWT_SECRET=replace-with-access-token-secret-min-32-chars

# Secret key used to sign and verify long-lived refresh tokens
JWT_REFRESH_SECRET=replace-with-refresh-token-secret-min-32-chars

# Expiration duration for access tokens (e.g., '1d', '2h', '15m')
JWT_ACCESS_EXPIRES_IN=1d

# Expiration duration for refresh tokens (e.g., '30d', '7d')
JWT_REFRESH_EXPIRES_IN=30d

# Expected issuer claim in JWT payloads
JWT_ISSUER=loggistick

# Expected audience claim in JWT payloads
JWT_AUDIENCE=loggistick-client

# Token version counter for global session invalidation
tokenVersion=1

# ------------------------------------------------------------------------------
# 4. COOKIE SECURITY
# ------------------------------------------------------------------------------
# Set to 'true' in production with HTTPS; 'false' for local development
COOKIE_SECURE=false

# SameSite cookie policy: 'lax', 'strict', or 'none' (use 'none' if client is cross-domain with HTTPS)
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN SEEDING
# ------------------------------------------------------------------------------
# Automatically seeded on first startup if no super admin account exists in DB
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password-min-8-chars

# ------------------------------------------------------------------------------
# 6. EMAIL SERVICE (SMTP NODEMAILER)
# ------------------------------------------------------------------------------
# Used for OTP verification, password resets, and user credential delivery
EMAIL_FROM=noreply@example.com
EMAIL_USER=noreply@example.com
EMAIL_PASS=replace-with-email-smtp-password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

# ------------------------------------------------------------------------------
# 7. CLIENT APPLICATIONS
# ------------------------------------------------------------------------------
# URL for the rider and driver mobile app download landing page
APP_DOWNLOAD_URL=https://loggistick.com/download

# ------------------------------------------------------------------------------
# 8. STRIPE PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key

# Webhook signing secret from Stripe Dashboard (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# Frontend redirect URLs after Stripe Checkout Session
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# ------------------------------------------------------------------------------
# 9. REDIS & BULLMQ DISTRIBUTED QUEUES
# ------------------------------------------------------------------------------
# Host and port for Redis / BullMQ workers (recurring bookings, notifications, push, emails)
# For Docker Compose: REDIS_HOST=redis, BULLMQIP=redis
# For Localhost:      REDIS_HOST=127.0.0.1, BULLMQIP=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BULLMQIP=127.0.0.1
BULLMQPORT=6379

# ------------------------------------------------------------------------------
# 10. TWILIO (SMS & TELEPHONY)
# ------------------------------------------------------------------------------
# Twilio credentials for SMS verification or direct dispatcher telephony
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_NUMBER=+10000000000

# ------------------------------------------------------------------------------
# 11. GOOGLE MAPS API
# ------------------------------------------------------------------------------
# Google Maps API Key with Geocoding, Places, and Distance Matrix enabled
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# ------------------------------------------------------------------------------
# 12. SOCIAL LOGIN (OAUTH 2.0)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Facebook OAuth Credentials
FACEBOOK_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret

# ------------------------------------------------------------------------------
# 13. FIREBASE ADMIN SDK (PUSH NOTIFICATIONS / FCM)
# ------------------------------------------------------------------------------
# Firebase Service Account credentials for push notifications
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Private key with escaped newlines (\n) enclosed in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"
